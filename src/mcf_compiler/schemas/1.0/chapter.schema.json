{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCF 1.0 chapter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "lessons"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^lessons/.*\\.mcf$"
      }
    }
  }
}
